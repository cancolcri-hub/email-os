# Email OS Template — Variables de entorno por cliente
# Copiar este archivo a .env y rellenar con las credenciales reales del cliente
# NUNCA commitear el archivo .env

# Brevo (email marketing)
BREVO_API_KEY=

# Supabase (base de datos de contactos)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# n8n (orquestación de flujos)
N8N_WEBHOOK_URL=
N8N_API_KEY=

# Identificador del cliente (debe coincidir con client_id en Supabase)
CLIENT_ID=

# Entorno
NODE_ENV=development
